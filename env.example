# Configuración de la base de datos
DATABASE_NAME=per_exams
DATABASE_USER=per_user
DATABASE_PASSWORD=per_password_change_me
DATABASE_PORT=5432

# Configuración de la API
API_PORT=5001
WEB_PORT=8095
DEBUG=false

# Configuración de autenticación
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_ACCESS_EXPIRE=60
JWT_REFRESH_EXPIRE=30

# Configuración de OpenAI
# IMPORTANTE: Reemplaza con tu API key real de OpenAI
OPENAI_API_KEY=tu_api_key_aqui
OPENAI_MODEL=gpt-5-2025-08-07
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# Configuración de CORS
CORS_ORIGINS=http://localhost:8095,http://127.0.0.1:8095

# Configuración de logging
LOG_LEVEL=INFO

# Configuración de rendimiento
API_WORKERS=4
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20
RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=20
ENABLE_GZIP=true
ENABLE_METRICS=true

# Configuración de monitoreo (opcional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
